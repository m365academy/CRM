@model LeadConvertForm
@inject Lookups Lookups
@{
    var lead = (Lead)ViewBag.Lead;
    var existingContact = ViewBag.ExistingContact as Contact;
    var organisations = await Lookups.OrganisationsAsync();
    var courses = await Lookups.CoursesAsync(Model.CourseId);
}

<section class="page-header compact">
  <div class="container">
    <div class="breadcrumb"><a href="/leads">Leads</a> / <a href="/leads/@lead.Id">@lead.Name</a> / Convert</div>
    <h1>Convert @lead.Name</h1>
    <p>Creates (or links) an organisation and contact, and optionally opens a deal in the pipeline at Qualified. The lead's history moves across.</p>
  </div>
</section>

<section class="app-section">
  <div class="container">
    <div class="panel form-panel">
      <form method="post" action="/leads/@lead.Id/convert" class="form-grid">
        @Html.AntiForgeryToken()

        <p class="form-section-title">Organisation</p>
        <div class="form-row">
          <div class="field">
            <label asp-for="OrganisationId">Existing organisation</label>
            <select asp-for="OrganisationId">
              <option value="">- None / create new -</option>
              @foreach (var o in organisations)
              {
                <option value="@o.Id" selected="@(Model.OrganisationId == o.Id)">@o.Name</option>
              }
            </select>
          </div>
          <div class="field">
            <label asp-for="NewOrganisationName">&hellip;or create a new one</label>
            <input asp-for="NewOrganisationName" maxlength="200" placeholder="Leave blank for an individual" />
          </div>
        </div>

        <p class="form-section-title">Contact</p>
        @if (existingContact is not null)
        {
          <div class="field-check">
            <input type="radio" id="useExisting" name="ContactId" value="@existingContact.Id" checked />
            <label for="useExisting">Use existing contact <a href="/contacts/@existingContact.Id">@existingContact.FullName</a> (same email)</label>
          </div>
          <div class="field-check">
            <input type="radio" id="createNew" name="ContactId" value="" />
            <label for="createNew">Create a new contact anyway</label>
          </div>
        }
        <div class="form-row">
          <div class="field">
            <label asp-for="FirstName">First name</label>
            <input asp-for="FirstName" maxlength="80" />
          </div>
          <div class="field">
            <label asp-for="LastName">Last name</label>
            <input asp-for="LastName" maxlength="80" />
          </div>
        </div>

        <p class="form-section-title">Deal</p>
        <label class="field-check"><input type="checkbox" asp-for="CreateDeal" data-toggle-deal /> Create a deal</label>
        <div data-deal-fields class="form-grid">
          <div class="field">
            <label asp-for="DealTitle">Deal title</label>
            <input asp-for="DealTitle" maxlength="200" />
          </div>
          <div class="form-row">
            <div class="field">
              <label asp-for="CourseId">Course</label>
              <select asp-for="CourseId">
                <option value="">- Not set -</option>
                @foreach (var c in courses)
                {
                  <option value="@c.Id" selected="@(Model.CourseId == c.Id)">@c.DisplayName</option>
                }
              </select>
            </div>
            <div class="field">
              <label asp-for="DeliveryFormat">Format</label>
              <select asp-for="DeliveryFormat">
                @foreach (var f in Enum.GetValues<DeliveryFormat>())
                {
                  <option value="@f" selected="@(Model.DeliveryFormat == f)">@Ui.Display(f)</option>
                }
              </select>
            </div>
          </div>
          <div class="form-row-3">
            <div class="field">
              <label asp-for="Delegates">Delegates</label>
              <input asp-for="Delegates" type="number" min="1" max="10000" />
            </div>
            <div class="field">
              <label asp-for="Value">Value (&pound;, ex VAT)</label>
              <input asp-for="Value" type="number" min="0" step="0.01" placeholder="Blank = catalogue price" />
            </div>
            <div class="field">
              <label asp-for="ExpectedCloseDate">Expected close</label>
              <input asp-for="ExpectedCloseDate" type="date" />
            </div>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-sm">Convert lead</button>
          <a href="/leads/@lead.Id" class="btn btn-ghost btn-sm">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</section>
